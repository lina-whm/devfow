{
  "__inputs": [],
  "__requires": [],
  "dashboard": {
    "title": "DevFlow Backend",
    "tags": ["devflow", "backend"],
    "timezone": "browser",
    "schemaVersion": 21,
    "panels": [
      {
        "id": 1,
        "title": "HTTP Request Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8},
        "targets": [
          {"expr": "rate(http_requests_total[1m])", "legendFormat": "{{method}} {{path}}"}
        ]
      },
      {
        "id": 2,
        "title": "HTTP Error Rate (5xx)",
        "type": "graph",
        "gridPos": {"x": 8, "y": 0, "w": 8, "h": 8},
        "targets": [
          {"expr": "rate(http_requests_total{status=~\"5..\"}[1m])", "legendFormat": "5xx"}
        ]
      },
      {
        "id": 3,
        "title": "Latency p50/p95/p99",
        "type": "graph",
        "gridPos": {"x": 16, "y": 0, "w": 8, "h": 8},
        "targets": [
          {"expr": "histogram_quantile(0.50, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p50"},
          {"expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p95"},
          {"expr": "histogram_quantile(0.99, rate(http_request_duration_seconds_bucket[5m]))", "legendFormat": "p99"}
        ]
      },
      {
        "id": 4,
        "title": "Go Routines",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 8, "h": 8},
        "targets": [
          {"expr": "go_goroutines", "legendFormat": "goroutines"}
        ]
      },
      {
        "id": 5,
        "title": "DB Connections",
        "type": "graph",
        "gridPos": {"x": 8, "y": 8, "w": 8, "h": 8},
        "targets": [
          {"expr": "pgxpool_acquired_connections", "legendFormat": "acquired"}
        ]
      },
      {
        "id": 6,
        "title": "Redis Operations",
        "type": "graph",
        "gridPos": {"x": 16, "y": 8, "w": 8, "h": 8},
        "targets": [
          {"expr": "rate(redis_commands_total[1m])", "legendFormat": "{{cmd}}"}
        ]
      }
    ]
  }
}
